<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/launch_background</item>
        <item name="windowSplashScreenBackground">@color/playtv_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/playtv_logo</item>
    </style>

    <style name="AppTheme.Player" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">#000000</item>
        <item name="android:colorAccent">@color/playtv_cyan</item>
        <item name="colorAccent">@color/playtv_cyan</item>
    </style>

    <style name="PlayTvPlayerCircleButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:layout_width">56dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:minWidth">56dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:background">@drawable/player_button_background</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:padding">0dp</item>
        <item name="android:textColor">@color/playtv_on_surface</item>
    </style>

    <style name="PlayTvPlayerCircleButtonLarge" parent="PlayTvPlayerCircleButton">
        <item name="android:layout_width">76dp</item>
        <item name="android:layout_height">76dp</item>
        <item name="android:minWidth">76dp</item>
        <item name="android:minHeight">76dp</item>
    </style>

    <style name="PlayTvPlayerCircleButtonPrimary" parent="Widget.AppCompat.ImageButton">
        <item name="android:layout_width">76dp</item>
        <item name="android:layout_height">76dp</item>
        <item name="android:minWidth">76dp</item>
        <item name="android:minHeight">76dp</item>
        <item name="android:background">@drawable/player_button_background</item>
        <item name="android:padding">21dp</item>
        <item name="android:tint">@color/playtv_on_surface</item>
    </style>

    <style name="PlayTvPlayerActionButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:background">@drawable/player_action_background</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:paddingHorizontal">18dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/playtv_on_surface</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
