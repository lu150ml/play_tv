<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/player_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        app:resize_mode="fit"
        app:show_buffering="when_playing"
        app:use_controller="false" />

    <ProgressBar
        android:id="@+id/player_buffering"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:indeterminateTint="@color/playtv_cyan"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/player_controls"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:animateLayoutChanges="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="112dp"
            android:background="@drawable/player_top_gradient"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingTop="12dp"
            android:paddingEnd="24dp"
            android:paddingBottom="28dp">

            <Button
                android:id="@+id/player_back"
                style="@style/PlayTvPlayerCircleButton"
                android:contentDescription="Voltar"
                android:text="‹"
                android:textSize="40sp" />

            <TextView
                android:id="@+id/player_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:maxLines="2"
                android:textColor="@color/playtv_on_surface"
                android:textSize="22sp" />

            <Button
                android:id="@+id/player_pip"
                style="@style/PlayTvPlayerCircleButton"
                android:contentDescription="Janela flutuante"
                android:text="▣"
                android:textSize="24sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/player_center_controls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/player_rewind"
                style="@style/PlayTvPlayerCircleButtonLarge"
                android:contentDescription="Voltar 10 segundos"
                android:text="↶ 10"
                android:textSize="18sp" />

            <ImageButton
                android:id="@+id/player_play_pause"
                style="@style/PlayTvPlayerCircleButtonPrimary"
                android:layout_marginHorizontal="42dp"
                android:contentDescription="Pausar"
                android:src="@android:drawable/ic_media_pause" />

            <Button
                android:id="@+id/player_forward"
                style="@style/PlayTvPlayerCircleButtonLarge"
                android:contentDescription="Avançar 10 segundos"
                android:text="10 ↷"
                android:textSize="18sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/player_bottom_controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@drawable/player_bottom_gradient"
            android:orientation="vertical"
            android:paddingStart="32dp"
            android:paddingTop="44dp"
            android:paddingEnd="32dp"
            android:paddingBottom="22dp">

            <LinearLayout
                android:id="@+id/player_seek_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/player_position"
                    android:layout_width="64dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="00:00"
                    android:textColor="@color/playtv_on_surface"
                    android:textSize="14sp" />

                <SeekBar
                    android:id="@+id/player_seek"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:max="1000"
                    android:progressTint="@color/player_seek_tint"
                    android:thumbTint="@color/playtv_cyan" />

                <TextView
                    android:id="@+id/player_duration"
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:gravity="end"
                    android:text="00:00"
                    android:textColor="@color/playtv_on_surface"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingTop="4dp">

                <Button
                    android:id="@+id/player_episodes"
                    style="@style/PlayTvPlayerActionButton"
                    android:text="Episódios" />

                <Button
                    android:id="@+id/player_tracks"
                    style="@style/PlayTvPlayerActionButton"
                    android:layout_marginHorizontal="20dp"
                    android:text="Áudio e legendas" />

                <Button
                    android:id="@+id/player_next"
                    style="@style/PlayTvPlayerActionButton"
                    android:text="Próximo episódio" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
